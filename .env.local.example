# ── Neon Database ─────────────────────────────────────────────
# Neon dashboard → your project → Connection string
# Use a separate branch (e.g. "staging") for local dev and preview deployments.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# ── Neon Auth ─────────────────────────────────────────────────
# Neon dashboard → Auth tab → Auth URL
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.ap-southeast-2.aws.neon.tech/neondb/auth

# ── Site ──────────────────────────────────────────────────────
# Public origin used in emails and links (no trailing slash). Per environment.
NEXT_PUBLIC_APP_URL=https://alpinecommunitybus.com.au
# Production only: every other host (old *.vercel.app, www.) 308-redirects here.
CANONICAL_HOST=alpinecommunitybus.com.au

# ── Resend (email) ────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be on a verified domain in your Resend account
EMAIL_FROM="Alpine Community Bus <bookings@alpinecommunitybus.com.au>"
# resend.com → Webhooks → your endpoint → Signing secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── Vercel Blob (damage photos on return) ─────────────────────
# Vercel → Storage → Blob → connect to project (adds this automatically)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# ── Local development only (optional) ─────────────────────────
# Point the Neon driver at a local Neon HTTP proxy instead of Neon. Ignored in production.
# NEON_FETCH_ENDPOINT=http://localhost:4444/sql
